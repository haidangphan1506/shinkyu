{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md", ".opencode/rules/*.md"],
  "formatter": true,
  "lsp": true,
  "permission": {
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git add*": "ask",
      "git commit*": "ask",
      "git push*": "ask"
    },
    "external_directory": {
      "*": "deny"
    },
    "read": {
      "*": "allow",
      ".env": "ask",
      ".env.*": "ask"
    },
    "edit": {
      "*": "allow",
      ".env": "ask",
      ".env.*": "ask"
    }
  }
}
